rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ogni utente legge e scrive solo i propri dati.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Catalogo alimenti comune: tutti gli utenti collegati lo leggono, solo l'amministratore lo modifica.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/catalogo/amministratori)
        && request.auth.uid in get(/databases/$(database)/documents/catalogo/amministratori).data.uids;
    }
    match /catalogo/modifiche {
      allow read: if request.auth != null;
      allow write: if isAdmin()
        && request.resource.data.righe is list
        && request.resource.data.rimossi is list;
    }
    match /catalogo/amministratori {
      allow read: if request.auth != null;
      // Il primo che lo crea diventa amministratore (solo se il documento non esiste ancora).
      allow create: if request.auth != null && request.resource.data.uids == [request.auth.uid];
      allow update, delete: if isAdmin();
    }
  }
}
